<resources>
    <style name="Theme.Lighty" parent="android:Theme.Material.Light.NoActionBar">
        <!-- windowBackground 透明，避免系统底色透出，交给 Compose 控制 -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.Lighty.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.Lighty</item>
    </style>
</resources>